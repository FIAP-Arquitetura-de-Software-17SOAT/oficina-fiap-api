        <object placeholders="1" c4Name="Sub-redes públicas" c4Type="Deployment Node" c4Description="NLB e NAT Gateway" label="&lt;div style=&quot;font-size:16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[%c4Type%]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:7px&quot;&gt;%c4Description%&lt;/div&gt;" id="dep-public">
