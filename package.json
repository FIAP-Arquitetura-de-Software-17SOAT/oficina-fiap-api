{
  "name": "oficina-fiap-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env LOG_LEVEL=silent jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:db": "cross-env NODE_OPTIONS=--experimental-vm-modules RUN_DATABASE_TESTS=true LOG_LEVEL=silent jest --config ./test/jest-e2e.json --runInBand",
    "test:seed": "jest --rootDir . prisma/seed.spec.ts prisma/seed-demo.spec.ts --runInBand",
    "seed:demo": "ts-node -r dotenv/config prisma/seed-demo.ts",
    "docker:dev": "mkdir -p node_modules generated && docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -V",
    "docker:prod": "docker compose -f docker-compose.yml up --build",
    "docker:migrate": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec app npx prisma migrate dev",
    "docker:demo": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile demo run --rm seed-demo",
    "docker:test": "mkdir -p node_modules generated && docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile test run --rm --build test",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile demo --profile test down --remove-orphans",
    "load:up": "sh test/load/preflight.sh && docker compose -p oficina-load -f docker-compose.yml -f docker-compose.load.yml up -d --build --wait app",
    "load:run": "docker compose -p oficina-load -f docker-compose.yml -f docker-compose.load.yml --profile load run --rm k6 run",
    "load:down": "docker compose -p oficina-load -f docker-compose.yml -f docker-compose.load.yml --profile load down -v --remove-orphans",
    "load:smoke": "npm run load:run -- scenarios/smoke.js",
    "load:race:stock": "npm run load:run -- scenarios/stock-race.js",
    "load:race:mechanic": "npm run load:run -- scenarios/mechanic-race.js",
    "load:race:refresh": "npm run load:run -- scenarios/auth-refresh-race.js",
    "load:race:budget": "npm run load:run -- scenarios/budget-decision-race.js",
    "load:journey": "npm run load:run -- scenarios/journey.js",
    "load:auth": "npm run load:run -- scenarios/auth-load.js",
    "load:seed": "npm run load:run -- scenarios/seed-volume.js",
    "load:read": "npm run load:run -- scenarios/read-heavy.js",
    "load:soak": "PROFILE=soak npm run load:journey"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "\\.dto\\.ts$",
      "/main\\.ts$",
      "/setup-app\\.ts$",
      "/prisma\\.service\\.ts$"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
