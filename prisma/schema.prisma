// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  // Sem isso o gerador escolhe a extensão dos imports conforme o tsconfig que
  // encontra no ambiente: gera ".js" na máquina do dev e ".ts" dentro do
  // Docker (onde o tsconfig não está presente no estágio), quebrando o build.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PartType {
  PART
  SUPPLY
}

enum MeasurementUnit {
  UNIT
  LITER
  KILOGRAM
}

enum StockMovementType {
  IN
  OUT
}

model User {
  id              String           @id @db.Uuid
  email           String           @unique
  passwordHash    String
  role            Role             @default(ADMIN)
  refreshSessions RefreshSession[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("user")
}

model RefreshSession {
  id        String    @id @db.Uuid
  jti       String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("refresh_session")
}

model Client {
  id       String @id @db.Uuid
  name     String
  document String @unique
  email    String @unique
  phone    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOrders ServiceOrder[]
  vehicles      Vehicle[]

  @@map("client")
}

model Part {
  id              String          @id
  code            String          @unique
  name            String
  description     String?
  type            PartType
  unit            MeasurementUnit
  unitPrice       Decimal         @db.Decimal(12, 2)
  quantity        Int
  minimumQuantity Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  stockMovements  StockMovement[]

  @@map("part")
}

model StockMovement {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  type           StockMovementType
  quantity       Int
  partId         String
  part           Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([partId])
  @@map("stock_movement")
model PurchaseOrder {
  id       String              @id @db.Uuid
  number   String              @unique
  supplier String
  status   PurchaseOrderStatus

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  items PurchaseOrderItem[]

  @@map("purchase_order")
}

model PurchaseOrderItem {
  id              String @id @db.Uuid
  purchaseOrderId String @db.Uuid

  partId String @db.Uuid

  quantity Int

  unitPriceCents Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_item")
}

enum PurchaseOrderStatus {
  NEEDS_PURCHASE
  AWAITING_DELIVERY
  DELIVERED
}

enum ServiceOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  AWAITING_PARTS
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum BudgetStatus {
  GENERATED
  WAITING_APPROVAL
  ACCEPTED
  REFUSED
}

enum BudgetItemType {
  SERVICE
  PART
}

model Budget {
  id             String       @id @db.Uuid
  serviceOrderId String       @db.Uuid
  version        Int
  status         BudgetStatus
  totalCents     Int
  refusalReason  String?
  sentAt         DateTime?
  answeredAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items BudgetItem[]

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  @@unique([serviceOrderId, version])
  @@index([serviceOrderId])
  @@map("budget")
}

model BudgetItem {
  id             String         @id @db.Uuid
  budgetId       String         @db.Uuid
  description    String
  type           BudgetItemType
  quantity       Decimal        @db.Decimal(10, 2)
  unitPriceCents Int
  subtotalCents  Int

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("budget_item")
}

model ServiceOrder {
  id                 String             @id @db.Uuid
  clientId           String             @db.Uuid
  vehicleId          String             @db.Uuid
  description        String
  status             ServiceOrderStatus
  cancellationReason String?
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  budgets Budget[]

  @@index([clientId])
  @@index([vehicleId])
  @@map("service_order")
}

model Vehicle {
  id       String @id @db.Uuid
  clientId String @db.Uuid
  plate    String @unique
  brand    String
  model    String
  year     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict (padrão) de propósito: apagar um cliente que ainda tem veículo
  // deve falhar, não levar o histórico junto. O erro é traduzido em 409.
  client        Client         @relation(fields: [clientId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([clientId])
  @@map("vehicle")
}
