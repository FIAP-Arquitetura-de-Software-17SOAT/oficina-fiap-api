// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  // Sem isso o gerador escolhe a extensão dos imports conforme o tsconfig que
  // encontra no ambiente: gera ".js" na máquina do dev e ".ts" dentro do
  // Docker (onde o tsconfig não está presente no estágio), quebrando o build.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PartType {
  PART
  SUPPLY
}

enum MeasurementUnit {
  UNIT
  LITER
  KILOGRAM
}

enum StockMovementType {
  IN
  OUT
}

model User {
  id              String           @id @db.Uuid
  email           String           @unique
  passwordHash    String
  role            Role             @default(ADMIN)
  refreshSessions RefreshSession[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("user")
}

model RefreshSession {
  id        String    @id @db.Uuid
  jti       String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("refresh_session")
}

model Client {
  id       String @id @db.Uuid
  name     String
  document String @unique
  email    String @unique
  phone    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOrders ServiceOrder[]
  vehicles      Vehicle[]

  @@map("client")
}

model Part {
  id                 String              @id @db.Uuid
  code               String              @unique
  name               String
  description        String?
  type               PartType
  unit               MeasurementUnit
  unitPriceCents     Int
  quantity           Int
  minimumQuantity    Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockMovements     StockMovement[]
  budgetItems        BudgetItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("part")
}

model StockMovement {
  id             String            @id @db.Uuid
  idempotencyKey String            @unique
  type           StockMovementType
  quantity       Int
  partId         String            @db.Uuid
  part           Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([partId])
  @@map("stock_movement")
}

model PurchaseOrder {
  id       String              @id @db.Uuid
  number   String              @unique
  supplier String
  status   PurchaseOrderStatus

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  items PurchaseOrderItem[]

  @@map("purchase_order")
}

model PurchaseOrderItem {
  id              String @id @db.Uuid
  purchaseOrderId String @db.Uuid

  partId String @db.Uuid

  quantity Int

  unitPriceCents Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // Restrict: apagar uma peça que ainda aparece em pedido de compra deve
  // falhar, e não deixar o item apontando para o vazio.
  part          Part          @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([partId])
  @@map("purchase_order_item")
}

enum PurchaseOrderStatus {
  NEEDS_PURCHASE
  AWAITING_DELIVERY
  DELIVERED
}

enum ServiceOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  AWAITING_PARTS
  IN_PROGRESS
  COMPLETED
  AWAITING_PAYMENT
  DELIVERED
  CANCELLED
}

enum BudgetStatus {
  GENERATED
  WAITING_APPROVAL
  ACCEPTED
  REFUSED
}

enum BudgetItemType {
  SERVICE
  PART
}

enum BillingStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  EXPIRED
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

enum NotificationType {
  BUDGET_READY
  PAYMENT_LINK_READY
  STOCK_PARTS_REQUESTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Budget {
  id             String       @id @db.Uuid
  // Referência externa ao agregado OrdemDeServico: sem FK de propósito, já que
  // o desenho de Event Storming trata orçamento e OS como agregados distintos.
  serviceOrderId String
  version        Int
  status         BudgetStatus
  totalCents     Int
  refusalReason  String?
  sentAt         DateTime?
  answeredAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items    BudgetItem[]
  billings Billing[]

  @@unique([serviceOrderId, version])
  @@index([serviceOrderId])
  @@map("budget")
}

/// `partId` é obrigatório em item do tipo PART e proibido em item do tipo
/// SERVICE. O Prisma não modela CHECK, então a restrição vive na migration
/// 20260829180000_require_budget_item_part_ref e na entidade `BudgetItem`.
model BudgetItem {
  id             String         @id @db.Uuid
  budgetId       String         @db.Uuid
  partId         String?        @db.Uuid
  serviceId      String?        @db.Uuid
  description    String
  type           BudgetItemType
  quantity       Decimal        @db.Decimal(10, 2)
  unitPriceCents Int
  subtotalCents  Int

  budget  Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  part    Part?    @relation(fields: [partId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([partId])
  @@index([serviceId])
  @@map("budget_item")
}

model Billing {
  id                   String         @id @db.Uuid
  serviceOrderId       String         @unique @db.Uuid
  budgetId             String         @db.Uuid
  status               BillingStatus
  amountCents          Int
  paymentLink          String?
  gatewayTransactionId String?        @unique
  paymentMethod        PaymentMethod?
  generatedAt          DateTime       @default(now())
  paidAt               DateTime?
  expiresAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  serviceOrder     ServiceOrder             @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  budget           Budget                   @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  checkoutSessions BillingCheckoutSession[]

  @@index([status])
  @@index([budgetId])
  @@map("billing")
}

model BillingCheckoutSession {
  id                   String         @id @default(uuid()) @db.Uuid
  billingId            String         @db.Uuid
  gatewayTransactionId String         @unique
  paymentMethod        PaymentMethod?
  paidAt               DateTime?
  createdAt            DateTime       @default(now())

  billing Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@index([billingId])
  @@map("billing_checkout_session")
}

model Notification {
  id        String             @id @db.Uuid
  type      NotificationType
  status    NotificationStatus
  to        String
  subject   String
  text      String
  html      String
  attempts  Int                @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("notification")
}

model ServiceOrder {
  id                 String             @id @db.Uuid
  clientId           String             @db.Uuid
  vehicleId          String             @db.Uuid
  description        String
  status             ServiceOrderStatus
  cancellationReason String?
  // O mecânico é ator do Event Storming, não agregado: guardamos só o id.
  mechanicId         String?            @db.Uuid
  // Início do timer. O tempo de execução é assignedAt -> completedAt.
  assignedAt         DateTime?
  // Registro de que o estoque atendeu esta OS. Sem ele a OS não entra em
  // execução: é o que impede marcar serviço feito sem peça ter saído.
  partsDispatchedAt  DateTime?
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  billing Billing?

  @@index([clientId])
  @@index([vehicleId])
  @@index([mechanicId])
  @@map("service_order")
}

model Service {
  id          String       @id @db.Uuid
  name        String       @unique
  description String?
  priceCents  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  budgetItems BudgetItem[]

  @@map("service")
}

model Vehicle {
  id       String @id @db.Uuid
  clientId String @db.Uuid
  plate    String @unique
  brand    String
  model    String
  year     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict (padrão) de propósito: apagar um cliente que ainda tem veículo
  // deve falhar, não levar o histórico junto. O erro é traduzido em 409.
  client        Client         @relation(fields: [clientId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([clientId])
  @@map("vehicle")
}
