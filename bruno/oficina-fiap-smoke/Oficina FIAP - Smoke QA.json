    {
      "name": "Gerar dados do smoke",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "description": "",
        "url": {
          "raw": "{{baseUrl}}/health",
          "protocol": "",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ],
          "query": [],
          "variable": []
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const useRandomData = String(pm.environment.get(\"useRandomData\")).toLowerCase() !== \"false\";",
              "if (!useRandomData) {",
              "  const runId = Date.now();",
              "  pm.variables.set(\"runId\", runId);",
              "  pm.variables.set(\"stockIdempotencyKey\", `${pm.environment.get(\"stockIdempotencyKey\")}-${runId}`);",
              "  return;",
              "}",
              "const rnd = (n) => Math.floor(Math.random() * n);",
              "const pick = (items) => items[rnd(items.length)];",
              "const letter = () => String.fromCharCode(65 + rnd(26));",
              "const runId = Date.now();",
              "const cnpjBase = Array.from({ length: 8 }, () => rnd(10)).concat([0, 0, 0, 1]);",
              "const cnpjDigit = (digits, weights) => {",
              "  const sum = digits.reduce((acc, digit, index) => acc + digit * weights[index], 0);",
              "  const rest = sum % 11;",
              "  return rest < 2 ? 0 : 11 - rest;",
              "};",
              "const cnpjD1 = cnpjDigit(cnpjBase, [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]);",
              "const cnpjD2 = cnpjDigit([...cnpjBase, cnpjD1], [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]);",
              "const suffix = (runId % 0xffffffffffff).toString(16).padStart(12, \"0\");",
              "const firstNames = [\"Ana\", \"Bruno\", \"Carla\", \"Diego\", \"Elisa\", \"Felipe\"];",
              "const lastNames = [\"Silva\", \"Souza\", \"Pereira\", \"Oliveira\", \"Costa\", \"Lima\"];",
              "const brands = [\"Fiat\", \"Volkswagen\", \"Chevrolet\", \"Toyota\", \"Honda\", \"Renault\"];",
              "const modelsByBrand = {",
              "  Fiat: [\"Argo\", \"Pulse\", \"Cronos\"],",
              "  Volkswagen: [\"Polo\", \"Virtus\", \"T-Cross\"],",
              "  Chevrolet: [\"Onix\", \"Tracker\", \"Spin\"],",
              "  Toyota: [\"Corolla\", \"Yaris\", \"Hilux\"],",
              "  Honda: [\"City\", \"HR-V\", \"Civic\"],",
              "  Renault: [\"Kwid\", \"Duster\", \"Sandero\"],",
              "};",
              "const services = [",
              "  [\"Troca de oleo e filtro\", \"Substituicao de oleo, filtro e revisao visual\"],",
              "  [\"Revisao de freios\", \"Inspecao e ajuste do sistema de freio\"],",
              "  [\"Alinhamento e balanceamento\", \"Ajuste de geometria e balanceamento das rodas\"],",
              "];",
              "const parts = [",
              "  [\"OIL-FILTER\", \"Filtro de oleo\", \"Filtro para oleo do motor\"],",
              "  [\"BRAKE-PAD\", \"Pastilha de freio\", \"Jogo de pastilhas dianteiras\"],",
              "  [\"AIR-FILTER\", \"Filtro de ar\", \"Filtro do sistema de admissao\"],",
              "];",
              "const clientName = `${pick(firstNames)} ${pick(lastNames)}`;",
              "const brand = pick(brands);",
              "const model = pick(modelsByBrand[brand]);",
              "const service = pick(services);",
              "const part = pick(parts);",
              "pm.variables.set(\"runId\", runId);",
              "pm.variables.set(\"clientName\", clientName);",
              "pm.variables.set(\"document\", [...cnpjBase, cnpjD1, cnpjD2].join(\"\"));",
              "pm.variables.set(\"plate\", `${letter()}${letter()}${letter()}${rnd(10)}${letter()}${rnd(10)}${rnd(10)}`);",
              "pm.variables.set(\"clientEmail\", `${clientName.toLowerCase().replace(\" \", \".\")}.${runId}@example.com`);",
              "pm.variables.set(\"clientPhone\", `(11) 9${String(rnd(100000000)).padStart(8, \"0\")}`);",
              "pm.variables.set(\"vehicleBrand\", brand);",
              "pm.variables.set(\"vehicleModel\", model);",
              "pm.variables.set(\"vehicleYear\", 2018 + rnd(8));",
              "pm.variables.set(\"serviceName\", `${service[0]} ${runId}`);",
              "pm.variables.set(\"serviceDescription\", service[1]);",
              "pm.variables.set(\"partCode\", `${part[0]}-${runId}`);",
              "pm.variables.set(\"partName\", part[1]);",
              "pm.variables.set(\"partDescription\", part[2]);",
              "pm.variables.set(\"serviceOrderDescription\", `${pick([\"Barulho\", \"Vibracao\", \"Falha intermitente\"])} em ${model}`);",
              "pm.variables.set(\"budgetServiceDescription\", service[0]);",
              "pm.variables.set(\"budgetPartDescription\", part[1]);",
              "pm.variables.set(\"stockIdempotencyKey\", `entrada-${runId}`);",
              "pm.variables.set(\"mechanicId\", `00000000-0000-4000-8000-${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// Tests",
              "pm.test(\"dados do smoke preparados\", function () {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "  pm.expect(pm.variables.get(\"runId\")).to.exist;",
              "  pm.expect(pm.variables.get(\"clientEmail\")).to.contain(\"@\");",
              "});",
              "if (pm.response.code >= 400) {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
