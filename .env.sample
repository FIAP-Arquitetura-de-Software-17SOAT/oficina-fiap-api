# Porta em que a API é exposta no host
PORT=3000

# Origem do frontend liberada via CORS
FRONTEND_ORIGIN=http://localhost:5173

# Postgres — usados pelo docker-compose para provisionar o banco
POSTGRES_PORT=5432
POSTGRES_DB=oficina_fiap
POSTGRES_PASSWORD=

NODE_ENV=development
LOG_LEVEL=debug

# Conexão usada pela aplicação e pelo Prisma CLI RODANDO NO HOST
# (npx prisma migrate dev / studio). Dentro do docker-compose o host correto
# é `db`, e lá a variável já é injetada pelo próprio compose.
DATABASE_URL=

# JWT — use distinct, high-entropy secrets outside local development
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# Initial administrator — used only by `npx prisma db seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP — para o MVP acadêmico, use credenciais do Ethereal
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STOCK_NOTIFICATION_EMAIL=
