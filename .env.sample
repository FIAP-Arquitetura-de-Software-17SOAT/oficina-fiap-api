# Modos do Docker (veja o README):
#   npm run docker:dev   desenvolvimento, hot reload e debugger (NODE_ENV=development)
#   npm run docker:prod  mesmas imagens do deploy (NODE_ENV=production; JWT com 32+ bytes)
#   npm run docker:test  testes contra um Postgres descartavel

# Porta em que a API é exposta no host
PORT=3000

# Porta do debugger do Node no modo docker:dev
DEBUG_PORT=9229

# Postgres — usados pelo docker-compose para provisionar o banco
POSTGRES_PORT=5432
POSTGRES_DB=oficina_fiap
POSTGRES_PASSWORD=

NODE_ENV=development
LOG_LEVEL=debug

# Conexão usada pela aplicação e pelo Prisma CLI RODANDO NO HOST
# (npx prisma migrate dev / studio). Dentro do docker-compose o host correto
# é `db`, e lá a variável já é injetada pelo próprio compose.
DATABASE_URL=

# JWT — use distinct, high-entropy secrets outside local development
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# Pagamentos (a implementacao atual aceita somente chave Stripe de teste)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Somente testes de carga (test/load): aponta o SDK para o fake. Deixe vazio.
STRIPE_API_BASE_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Initial administrator — used only by `npx prisma db seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP — para o MVP acadêmico, use credenciais do Ethereal
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STOCK_NOTIFICATION_EMAIL=

# Endereço público da API, usado no link de aprovação do email do orçamento
# (GET /api/v1/budgets/webhooks/decision?token=...). Padrão: http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
